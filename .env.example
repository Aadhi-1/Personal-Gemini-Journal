# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY:
# Required for Google Maps JavaScript API, Places (New), and Geocoding features.
# For prototyping, you can generate a free Maps Demo Key without billing at:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
# For production, create a restricted key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# SLACK_WEBHOOK_URL: Optional Slack Incoming Webhook URL for external parsed reflection alerts
SLACK_WEBHOOK_URL=""

# DISCORD_WEBHOOK_URL: Optional Discord Webhook URL for external parsed reflection alerts
DISCORD_WEBHOOK_URL=""

# NOTIFICATION_ALERT_EMAIL: Optional destination email address for parsed reflection summaries
NOTIFICATION_ALERT_EMAIL=""

# NOTIFICATION_SECRET: Secret token for authenticating administrative notification dispatch calls
NOTIFICATION_SECRET=""

