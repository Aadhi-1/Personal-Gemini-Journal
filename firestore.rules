rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to prevent unintentional exposure
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped Admin Verification & Dynamic Document Lookups
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'gaudhamanaadhithyiaan@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User-isolated interactions and reflections
    match /users/{userId}/interactions/{interactionId} {
      // Strictly isolate read and write operations to the authenticated document owner or elevated admin
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Admin profiles and privilege records
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // System-level notification rules and webhook configurations
    match /system/notifications {
      allow read, write: if isAdmin();
    }

    // Append-only administrative and security audit trail logs
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
