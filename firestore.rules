rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to prevent unintentional exposure
    match /{document=**} {
      allow read, write: if false;
    }

    // User-isolated interactions and reflections
    match /users/{userId}/interactions/{interactionId} {
      // Strictly isolate read and write operations to the authenticated document owner
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
